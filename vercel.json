{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd site && bun install --frozen-lockfile",
  "buildCommand": "cd site && bun run validate",
  "outputDirectory": "site/dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "awesome-pi-list.vercel.app" }],
      "destination": "https://piindex.dev/:path*",
      "permanent": true
    }
  ]
}
